# Lumida self-hosted settings. Copy to .env next to docker-compose.yml and fill in.
# .env holds secrets: keep it out of version control.

# --- Lumida's own metadata database (the "metadata" service) -----------------------
POSTGRES_USER=lumida
# Letters and digits only (it's also used inside a connection URL).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=lumida

# --- Your databases ---------------------------------------------------------------
# One URL per database, under any name; register it with
#   docker compose exec lumida lumida source add shop --connection-ref SHOP_DB_URL
# Use a read-only login: docs/setup/databases.md and scripts/postgres/.
# SHOP_DB_URL=postgresql+psycopg://lumida_readonly:<password>@db-host:5432/shop
# SHOPDB_MYSQL_URL=mysql+pymysql://lumida:<password>@db-host:3306/shop

# --- Alerts (optional) --------------------------------------------------------------
# A Slack incoming-webhook URL under any name; attach it with
#   docker compose exec lumida lumida source alerts shop --webhook-ref SLACK_DATA_ALERTS
# SLACK_DATA_ALERTS=https://hooks.slack.com/services/...

# --- AI features (optional; off by default) ---------------------------------------
LUMIDA_LLM_PROVIDER=none
# LUMIDA_GEMINI_API_KEY=

# --- Service --------------------------------------------------------------------------
LUMIDA_LOG_LEVEL=INFO
LUMIDA_LOG_FORMAT=json
LUMIDA_SCHEDULER_TICK_SECONDS=60
