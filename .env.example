# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/aidi

# Snowflake Credentials
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your_user
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase  # Optional
SNOWFLAKE_ROLE=AI_DI_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=YOUR_DB

# dbt configuration
DBT_MANIFEST_PATH=/path/to/target/manifest.json

# LLM Configuration (Phase 3+)
OPENAI_API_KEY=sk-placeholder-key

# App Configuration
LOG_LEVEL=INFO
