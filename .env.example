# Copy to .env and fill in. .env is git-ignored; never commit real values.
# App settings use the AIDE_ prefix (see src/ai_data_engineer/config.py).

# --- Local Postgres (docker-compose.yml reads these) -----------------------
POSTGRES_USER=aide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aide
POSTGRES_PORT=5432

# --- Metadata store ----------------------------------------------------------
# SQLAlchemy URL, psycopg v3 driver. Must match the POSTGRES_* values above.
AIDE_DATABASE_URL=postgresql+psycopg://aide:change-me@localhost:5432/aide

# DEBUG | INFO | WARNING | ERROR
AIDE_LOG_LEVEL=INFO

# --- Customer databases -----------------------------------------------------
# Configured per data source from Stage 1.3 (connection details referenced by name,
# never stored in the metadata store). The Snowflake test variables are documented
# in docs/setup/snowflake_setup.md and return in Stage 3.

# --- Alerting ------------------------------------------------------------------
AIDE_SLACK_WEBHOOK_URL=
